{
  "mcpServers": {
    "voxforg": {
      "command": "cargo",
      "args": [
        "run",
        "-p",
        "voxforg-cli",
        "--",
        "mcp"
      ],
      "env": {
        "RUST_LOG": "info"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated"
      ]
    }
  }
}
